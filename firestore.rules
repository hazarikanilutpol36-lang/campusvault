rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidNumber(val, minVal, maxVal) {
      return (val is int || val is float) && val >= minVal && val <= maxVal;
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidBudgetProfile(data) {
      return data.keys().hasAll([
        'userId',
        'monthlyAllowance',
        'savingsBalance',
        'alertThresholdPercent',
        'foodLimit',
        'housingLimit',
        'transitLimit',
        'subscriptionsLimit',
        'socialLimit',
        'essentialsLimit',
        'createdAt',
        'updatedAt'
      ]) && data.keys().hasOnly([
        'userId',
        'monthlyAllowance',
        'savingsBalance',
        'alertThresholdPercent',
        'foodLimit',
        'housingLimit',
        'transitLimit',
        'subscriptionsLimit',
        'socialLimit',
        'essentialsLimit',
        'createdAt',
        'updatedAt'
      ])
      && isValidId(data.userId)
      && data.userId == request.auth.uid
      && isValidNumber(data.monthlyAllowance, 0, 1000000)
      && isValidNumber(data.savingsBalance, 0, 10000000)
      && isValidNumber(data.alertThresholdPercent, 50, 100)
      && isValidNumber(data.foodLimit, 0, 100000)
      && isValidNumber(data.housingLimit, 0, 100000)
      && isValidNumber(data.transitLimit, 0, 100000)
      && isValidNumber(data.subscriptionsLimit, 0, 100000)
      && isValidNumber(data.socialLimit, 0, 100000)
      && isValidNumber(data.essentialsLimit, 0, 100000)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidExpenseRecord(data) {
      return data.keys().hasAll([
        'userId',
        'title',
        'category',
        'amount',
        'dateStr',
        'paymentMethod',
        'isRecurring',
        'roundUpSaved',
        'createdAt'
      ]) && data.keys().hasOnly([
        'userId',
        'title',
        'category',
        'amount',
        'dateStr',
        'paymentMethod',
        'isRecurring',
        'roundUpSaved',
        'createdAt'
      ])
      && isValidId(data.userId)
      && data.userId == request.auth.uid
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
      && data.category is string && data.category.size() <= 40
      && (
        data.category == 'Food & Dining' ||
        data.category == 'Textbooks & Academic' ||
        data.category == 'Campus Transit' ||
        data.category == 'Subscriptions & Apps' ||
        data.category == 'Coffee & Social' ||
        data.category == 'Dorm & Essentials'
      )
      && isValidNumber(data.amount, 0.01, 100000)
      && data.dateStr is string && data.dateStr.size() == 10 && data.dateStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && data.paymentMethod is string && data.paymentMethod.size() <= 30
      && (
        data.paymentMethod == 'Campus Card' ||
        data.paymentMethod == 'Debit Card' ||
        data.paymentMethod == 'UPI / Wallet' ||
        data.paymentMethod == 'Cash'
      )
      && data.isRecurring is bool
      && isValidNumber(data.roundUpSaved, 0, 100)
      && data.createdAt is timestamp;
    }

    function isValidInvestmentHolding(data) {
      return data.keys().hasAll([
        'userId',
        'assetClass',
        'instrumentName',
        'investedAmount',
        'unitsOwned',
        'expectedApy',
        'riskTier',
        'autoInvestMonthly',
        'createdAt',
        'updatedAt'
      ]) && data.keys().hasOnly([
        'userId',
        'assetClass',
        'instrumentName',
        'investedAmount',
        'unitsOwned',
        'expectedApy',
        'riskTier',
        'autoInvestMonthly',
        'createdAt',
        'updatedAt'
      ])
      && isValidId(data.userId)
      && data.userId == request.auth.uid
      && data.assetClass is string && data.assetClass.size() <= 40
      && (
        data.assetClass == 'Low-Risk Savings' ||
        data.assetClass == 'Automated Index Funds' ||
        data.assetClass == 'Crypto' ||
        data.assetClass == 'P2P Lending' ||
        data.assetClass == 'Digital Gold & Silver'
      )
      && data.instrumentName is string && data.instrumentName.size() >= 1 && data.instrumentName.size() <= 100
      && isValidNumber(data.investedAmount, 0, 10000000)
      && isValidNumber(data.unitsOwned, 0, 100000000)
      && isValidNumber(data.expectedApy, 0, 100)
      && data.riskTier is string && data.riskTier.size() <= 20
      && (
        data.riskTier == 'Low' ||
        data.riskTier == 'Moderate' ||
        data.riskTier == 'High' ||
        data.riskTier == 'Precious Metal'
      )
      && isValidNumber(data.autoInvestMonthly, 0, 100000)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /budgets/{budgetId} {
      allow get: if isSignedIn() && isValidId(budgetId) && budgetId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(budgetId)
        && budgetId == request.auth.uid
        && isValidBudgetProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(budgetId)
        && budgetId == request.auth.uid
        && isValidBudgetProfile(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Update Budget Limits & Alert Threshold
          incoming().diff(existing()).affectedKeys().hasOnly([
            'monthlyAllowance',
            'alertThresholdPercent',
            'foodLimit',
            'housingLimit',
            'transitLimit',
            'subscriptionsLimit',
            'socialLimit',
            'essentialsLimit',
            'updatedAt'
          ]) ||
          // Action 2: Adjust Savings Pool Balance (Deposit from optimization or Transfer to Investment)
          incoming().diff(existing()).affectedKeys().hasOnly([
            'savingsBalance',
            'updatedAt'
          ])
        );

      allow delete: if false;
    }

    match /expenses/{expenseId} {
      allow get: if isSignedIn() && isValidId(expenseId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(expenseId)
        && isValidExpenseRecord(incoming())
        && incoming().createdAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(expenseId)
        && isValidExpenseRecord(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'category',
          'amount',
          'dateStr',
          'paymentMethod',
          'isRecurring',
          'roundUpSaved'
        ]);

      allow delete: if isVerifiedUser()
        && isValidId(expenseId)
        && existing().userId == request.auth.uid;
    }

    match /investments/{investmentId} {
      allow get: if isSignedIn() && isValidId(investmentId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(investmentId)
        && isValidInvestmentHolding(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(investmentId)
        && isValidInvestmentHolding(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().assetClass == existing().assetClass
        && incoming().instrumentName == existing().instrumentName
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'investedAmount',
          'unitsOwned',
          'autoInvestMonthly',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidId(investmentId)
        && existing().userId == request.auth.uid;
    }
  }
}
